# Cloudflare Pages 憑證。複製成 .env 後填入；.env 已被 gitignore。
# Token: https://dash.cloudflare.com/profile/api-tokens （選 "Cloudflare Pages" 範本）
CLOUDFLARE_API_TOKEN=
# Account ID: 執行 `npx wrangler whoami`
CLOUDFLARE_ACCOUNT_ID=
# Pages 專案名稱  ->  https://<name>.pages.dev
CF_PAGES_PROJECT=gym-course
# 要部署的目錄
CF_PAGES_DIR=dist

# 影片內容查核（make verify-content）。沒有這個金鑰不會擋住 make，只會略過該步驟。
# Google AI Studio 取得：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 讀取使用者文字回饋（make feedback）。同一個值也要設進 Cloudflare：
#   npx wrangler pages secret put FEEDBACK_TOKEN --project-name thyroid-us
# 產生：openssl rand -hex 24
FEEDBACK_TOKEN=
